# ==============================================================================
# SunoSamjho Live - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gnani AI Credentials (Server-side only)
# Sign up at https://gnani.ai to obtain API credentials for Prisma, Evon & Timbre.
# ------------------------------------------------------------------------------
GNANI_API_KEY=
GNANI_API_KEY_ID=
GNANI_API_KEY_SECRET=
GNANI_API_BASE_URL=https://api.gnani.ai

# ------------------------------------------------------------------------------
# Mock Provider Switch (Development and Testing only)
# Set to 'true' to run with a simulated provider if you do not yet have Gnani credentials.
# STRICT SAFETY GUARD: Will throw an error if enabled when NODE_ENV=production.
# ------------------------------------------------------------------------------
ENABLE_MOCK_PROVIDER=true

# ------------------------------------------------------------------------------
# Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase Configuration
# Server requires service role key for admin tasks & API key lookups.
# Client requires anon key and URL.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Client API Connection
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000
SUNOSAMJHO_API_BASE_URL=http://localhost:4000
